# Salin jadi .env.local untuk mode dual (localStorage + Supabase).
# Kosongkan / jangan buat file ini kalau mau tetap mode lokal murni.
#
# PENTING: pakai anon/publishable key (public), JANGAN service_role key.
# Atur juga di dashboard Vercel: Settings → Environment Variables (Production + Preview).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
